# Copy to your shell profile or a private env file OUTSIDE the repo. Never commit real values.
# Placeholders only. Most users need NONE of the Meta values: the official Meta Ads MCP uses OAuth.

# --- Ads God Mode core ---
# Where client profiles, tickets and the audit log live (outside the repo).
ADS_GODMODE_HOME=~/.ads-godmode
# Optional custom audit log path.
ADS_GODMODE_AUDIT_LOG=
# Full auto stays disabled unless the operator sets 1 on this machine.
ADS_GODMODE_ENABLE_FULL_AUTO=0

# --- Meta self-hosted fallback (getmcpads meta-ads-mcp-server) - only if you use it ---
# System User token with ads_read (+ ads_management only if writes are enabled). Set it in the MCP server's env, not in Claude's shell.
META_ACCESS_TOKEN=
META_ENABLE_WRITES=0
META_API_VERSION=v26.0

# --- Google Ads (official MCP for reads + bundled writer for writes) ---
GOOGLE_PROJECT_ID=
# Developer tokens were retired by Google on 2026-09-09 (access now belongs to the Cloud project).
# google-ads >= 34.0.0 treats it as optional (verified 2026-10-26); leave empty.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) id without dashes, if you access client accounts through a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_USE_PROTO_PLUS=true

# --- Google Ads MCP OAuth proxy mode (optional, server-side only) ---
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_MCP_STORAGE_ENCRYPTION_KEY=
